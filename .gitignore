# Arquivos de configuração com credenciais reais e segredos (nunca versionar)
/config/env.local.php
/config/env.production.php
.env
.env.*
!.env.example
worker_service/.env
worker_service/.env.*
!worker_service/.env.example
*.key
*.pem

# Python (worker local — não versionar bytecode)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Uploads, locks e dados locais de execução
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/.htaccess
/storage/clips/*
!/storage/clips/.gitkeep
!/storage/clips/.htaccess
/storage/logs/*
!/storage/logs/.gitkeep
/storage/budget_ledger.json
/storage/budget_ledger.lock
/storage/single_worker.lock
/storage/audit_*.log
/uploads/videos/*
!/uploads/videos/.gitkeep

# Banco de dados de testes automatizados locais
/config/*.sqlite
/config/*.db
/storage/*.sqlite
/storage/*.db
/tests/*.sqlite

# Pacote gerado para Hostinger (deploy/build-hostinger-package.ps1)
/deploy/staging-hostinger/
/deploy/*.zip

# Logs e arquivos temporários
*.log
*.bak
.DS_Store
Thumbs.db

# ==============================================================================
# ClipIA Worker Service — Variáveis de Ambiente (.env.example)
# Copie este arquivo para `worker_service/.env` e ajuste conforme seu ambiente.
# ==============================================================================

# --- 1. Integração Autenticada com o Backend PHP ---
# Desenvolvimento local (PHP embutido):
CLIPIA_BACKEND_API_URL=http://127.0.0.1:8099/pages/worker-api.php
# Hostinger (worker no Windows — copie para worker_service/.env, NÃO commite):
# CLIPIA_BACKEND_API_URL=https://clipia.sthevandev.com.br/pages/worker-api.php
# Mesmo valor de WORKER_SHARED_SECRET em private/clipia.env.php na Hostinger (min. 16 caracteres).
# Nao deixe a linha vazia (CLIPIA_WORKER_SHARED_SECRET=): preencha o valor ou comente/remova a linha.
# Com backend remoto (HTTPS), segredo vazio impede HMAC ate voce preencher manualmente.
CLIPIA_WORKER_SHARED_SECRET=clipia-dev-hmac-secret-key-change-in-production-2026
CLIPIA_VERIFY_TLS=true

# --- 2. Transcrição Local com faster-whisper ---
# Tamanhos suportados: tiny, base, small, medium, large-v3
CLIPIA_WHISPER_MODEL=base
# Dispositivo: cpu ou cuda (placa NVIDIA)
CLIPIA_WHISPER_DEVICE=cpu
# Tipo de computação: int8 (recomendado para CPU), float16 (para GPU CUDA) ou float32
CLIPIA_WHISPER_COMPUTE_TYPE=int8
CLIPIA_WHISPER_LANGUAGE=pt

# --- 3. Análise por Blocos com Contexto ---
# Duração alvo de cada bloco de análise (em segundos) e janela de contexto anterior
CLIPIA_CHUNK_WINDOW_SECONDS=120
CLIPIA_CHUNK_OVERLAP_SECONDS=25

# --- 4. Provedor de IA Configurável & Controle Estrito de Custos ---
# Valores suportados:
#   - local_heuristic   : Analisador semântico estruturado local (PADRÃO — 100% gratuito, zero custo de API)
#   - openai_compatible : Usa API oficial da OpenAI (ou endpoint compatível) enviando apenas trechos de texto
CLIPIA_AI_PROVIDER=local_heuristic

# Trava de segurança de custos: mesmo que OPENAI_API_KEY esteja definida, serviços pagos
# NUNCA são iniciados automaticamente a menos que CLIPIA_ALLOW_PAID_API=true
CLIPIA_ALLOW_PAID_API=false

CLIPIA_LLM_BASE_URL=https://api.openai.com/v1
# Chave da OpenAI API (use apenas valor real no ambiente local/VPS do worker; nunca versione chaves reais)
OPENAI_API_KEY=your_openai_api_key_here_do_not_commit
# Alias opcional legado (se OPENAI_API_KEY estiver definida, ela tem prioridade)
CLIPIA_LLM_API_KEY=
# Modelo configurável via variável de ambiente (ex.: gpt-4o-mini, gpt-4.1-mini, etc.)
CLIPIA_LLM_MODEL=gpt-4o-mini
CLIPIA_LLM_TIMEOUT_SECONDS=30

# --- 5. Limites Técnicos de Uso por Tarefa ---
CLIPIA_MAX_AUDIO_DURATION_SECONDS=5400
CLIPIA_MAX_LLM_CALLS_PER_JOB=12
CLIPIA_MAX_LLM_TOKENS_PER_JOB=24000
CLIPIA_MAX_RETRIES_PER_TASK=2

# --- 6. Limites Financeiros e Teto Mensal Persistente (Orçamento de R$ 100/mês) ---
# Limite máximo de gasto por tarefa em Reais (R$)
CLIPIA_MAX_COST_PER_JOB_BRL=2.50
# Teto mensal global da aplicação em Reais (R$) — bloqueia novas chamadas ao atingir R$ 100,00
CLIPIA_MAX_MONTHLY_COST_BRL=100.00
# Taxa de conversão USD -> BRL e tarifas por 1 milhão de tokens para cálculo conservador
CLIPIA_USD_TO_BRL_RATE=5.80
CLIPIA_INPUT_COST_PER_1M_USD=0.15
CLIPIA_OUTPUT_COST_PER_1M_USD=0.60
# Piso mínimo contabilizado por chamada HTTP (garante bloqueio mesmo se o provedor omitir tokens/custos)
CLIPIA_MIN_COST_PER_CALL_BRL=0.02
# Arquivo persistente local onde o consumo mensal sobrevive a reinicializações do worker
CLIPIA_BUDGET_LEDGER_PATH=../storage/budget_ledger.json

# --- 7. FFmpeg (opcional; vazio = usar ffmpeg/ffprobe do PATH do Windows) ---
CLIPIA_FFMPEG_BINARY=
